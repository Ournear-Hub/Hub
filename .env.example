# =============================================================================
# LOCAL DEVELOPMENT ONLY
# =============================================================================
# This file is a local-development template. It is NOT production-ready.
#
# Do not copy these values into Hostinger / production as-is:
#   - APP_DEBUG=true
#   - empty APP_KEY
#   - MAIL_MAILER=log
#   - QUEUE_CONNECTION=database without a running queue worker
#   - SESSION_DRIVER=database / CACHE_STORE=database without the matching tables
#
# Production must set APP_ENV=production, APP_DEBUG=false, a generated APP_KEY,
# a real mailer, TRUSTED_PROXIES if SSL is terminated, and cron + queue workers.
# Run `php artisan migrate` for pending migrations only. Never migrate:rollback
# Stage 7–10 files on production (their down() methods drop live tables).
# Web root is Laravel public/. Do not deploy leftover Hostinger copies.
# =============================================================================

APP_NAME="OurNear Hire"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Browser tab title fallback (Vite); should match APP_NAME unless you need a longer label.
VITE_APP_NAME="OurNear Hire"
APP_PREVIOUS_KEYS=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ournear_talent
DB_USERNAME=root
DB_PASSWORD=

# Local defaults. Production should choose drivers that match the server setup
# and must run `php artisan queue:work` if QUEUE_CONNECTION=database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Local default: log (no SMTP). For Brevo transactional mail in staging/production:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=          # Brevo SMTP login (not the HTTP API key)
#   MAIL_PASSWORD=          # Brevo SMTP key from SMTP & API → SMTP (never commit)
#   MAIL_FROM_ADDRESS=      # Must be a Brevo-verified sender/domain
#   MAIL_FROM_NAME="OurNear Hire"
# Optional local delivery probe recipient (manual tests only):
# MAIL_TEST_TO=
#
# Runtime From/Reply-To for most app mail still comes from Admin → Website Settings
# (primary/support/recruitment/reply_to). MAIL_FROM_* is the Laravel fallback when
# website settings do not define a primary company email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="OurNear Hire"
# Live Brevo QA only (phpunit.brevo-live.xml); leave empty in shared templates.
MAIL_TEST_TO=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

ANALYTICS_ENABLED=false
ANALYTICS_ID=

TRUSTED_PROXIES=

# Mobile OTP (Stage 23C). Do not put SMS provider secrets here until a provider is selected.
# SMS_OTP_DRIVER=unconfigured
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_SECONDS=60

# WhatsApp Cloud API (Stage 23D). Official Meta WhatsApp Business Platform only.
# Company click-to-chat numbers are Admin Website Settings, not these variables.
# Leave WHATSAPP_PROVIDER=unconfigured until Meta credentials exist. Do not commit secrets.
# WHATSAPP_PROVIDER=unconfigured
# WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# WHATSAPP_GRAPH_API_VERSION=
# WHATSAPP_GRAPH_TIMEOUT=15
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# WhatsApp OTP (Stage 23E). Template name must match a Meta-approved authentication template.
# Leave empty until the template exists. Do not commit secrets.
# WHATSAPP_OTP_TEMPLATE_NAME=
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# WHATSAPP_OTP_INCLUDE_COPY_BUTTON=true
