# Copy to config/local.env (gitignored). Required before any run.
# Values in local.env override this file (including passwords).

OURNEAR_ALLOW_RUN=local
OURNEAR_BASE_URL=http://127.0.0.1:8000

# Staging (opt-in): set OURNEAR_ALLOW_RUN=staging AND exact hostnames below.
# Comma-separated; exact hostname match only (no wildcards). Port comes from OURNEAR_BASE_URL.
# OURNEAR_STAGING_HOSTS=staging.example.test

# Optional: use qa:hiring-fixtures accounts on local only
OURNEAR_QA_CANDIDATE_EMAIL=qa-candidate@example.test
OURNEAR_QA_CANDIDATE_PASSWORD=
OURNEAR_QA_EMPLOYER_A_EMAIL=qa-employer-a@example.test
OURNEAR_QA_EMPLOYER_A_PASSWORD=
OURNEAR_QA_EMPLOYER_B_EMAIL=qa-employer-b@example.test
OURNEAR_QA_EMPLOYER_B_PASSWORD=
OURNEAR_QA_ADMIN_EMAIL=admin@ournear.test
OURNEAR_QA_ADMIN_PASSWORD=

# Optional: legacy override (tests prefer scripts/qa-provision-journey-apply-job.php)
OURNEAR_QA_APPLY_JOB_SLUG=
OURNEAR_QA_APPLY_JOB_TITLE=
